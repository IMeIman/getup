---
type Variant = "primary" | "secondary" | "outline" | "ghost" | "destructive";
type Size = "sm" | "md" | "lg";

interface BaseProps {
  variant?: Variant;
  size?: Size;
  disabled?: boolean;
  class?: string;
}

interface ButtonAsButton extends BaseProps {
  as?: "button";
  type?: "button" | "submit" | "reset";
}

interface ButtonAsLink extends BaseProps {
  as: "a";
  href: string;
}

type Props = ButtonAsButton | ButtonAsLink;

const {
  as = "button",
  variant = "primary",
  size = "md",
  disabled = false,
  class: className,
  ...rest
} = Astro.props;

/* ── Variant classes ───────────────────────────────────────── */
const variants: Record<Variant, string> = {
  primary:
    "bg-secondary text-primary-50 hover:bg-secondary-600 active:bg-seconday-800 w-full sm:w-fit",
  secondary:
    "bg-primary-100 text-primary hover:bg-primary-100/10 active:bg-primary-100/20 w-full sm:w-fit",
  outline:
    "border border-secondary-200 bg-transparent text-secondary hover:text-secondary-700 hover:bg-primary-200/20 active:bg-primary-200/40 w-full sm:w-fit",
  ghost:
    "bg-transparent text-primary-500 hover:bg-primary-100 hover:text-primary active:bg-primary-200 w-full sm:w-fit",
  destructive:
    "bg-red-600 text-white hover:bg-red-700 active:bg-red-800",
};

/* ── Size classes ──────────────────────────────────────────── */
const sizes: Record<Size, string> = {
  sm: "h-8 px-3 text-xs gap-1.5",
  md: "h-10 px-5 text-sm gap-2",
  lg: "h-12 px-7 text-base gap-2.5",
};

/* ── Common classes ────────────────────────────────────────── */
const classes = [
  "inline-flex items-center justify-center font-medium rounded-lg",
  "transition-colors duration-150 ease-out",
  "focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary-950",
  "disabled:pointer-events-none disabled:opacity-50",
  "select-none whitespace-nowrap",
  variants[variant],
  sizes[size],
  className,
];
---

{as === "a" ? (
  <a class:list={classes} href={(rest as ButtonAsLink).href}>
    <slot />
  </a>
) : (
  <button
    class:list={classes}
    type={(rest as ButtonAsButton).type ?? "button"}
    disabled={disabled}
  >
    <slot />
  </button>
)}
