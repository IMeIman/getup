---
interface Props {
  images: string[];
  speed?: number; // Tiempo en segundos por vuelta
  direction?: 'left' | 'right'; // Prop opcional para controlar la dirección
}

const { images = [], speed = 20, direction = 'left' } = Astro.props as Props;

const duplicatedImages = [...images, ...images];

// Determinamos la clase de animación según la prop `direction`
const animationClass = direction === 'left' 
  ? 'animate-[infinite-scroll-left_var(--speed)_linear_infinite]' 
  : 'animate-[infinite-scroll-right_var(--speed)_linear_infinite]';
---

<div class="relative w-full overflow-hidden rounded-xl">
  <div 
    class={`flex w-max gap-3 ${animationClass}`}
    style={`--speed: ${speed}s;`}
  >
    {duplicatedImages.map((src, i) => (
      <div class="shrink-0 overflow-hidden rounded-xl bg-primary-950/10 shadow-md">
        <img 
          src={src} 
          alt={`Item ${i}`} 
          class="h-48 w-auto md:h-72  object-cover pointer-events-none" 
        />
      </div>
    ))}
  </div>
</div>