---
interface Props {
  src: string;
  alt: string;
  width?: number;
  height?: number;
  class?: string;
}

const {
  src,
  alt,
  width = 800,
  height = 600,
  class: className,
} = Astro.props;
---

<div class:list={[
  "relative overflow-hidden rounded-2xl bg-primary-100",
  className,
]}>
  <img
    {src}
    {alt}
    {width}
    {height}
    loading="eager"
    decoding="async"
    class="h-full w-full object-cover"
  />
</div>
