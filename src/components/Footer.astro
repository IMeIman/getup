---
interface FooterSection {
  title: string;
  links: { label: string; href: string }[];
}

interface Props {
  logo?: string;
  description?: string;
  email?: string;
  phone?: string;
  location?: string;
  sections?: FooterSection[];
  class?: string;
}

const {
  logo = "Getup",
  description = "Construye sitios web modernos con un design system completo.",
  email = "hello@getup.dev",
  phone = "+1 (555) 123-4567",
  location = "Ciudad de México, MX",
  sections = [],
  class: className,
} = Astro.props;

const base = import.meta.env.BASE_URL;
const year = new Date().getFullYear();
---

<footer>
  <div class="max-w-7xl bg-secondary px-4 mx-4 sm:mx-6 rounded-2xl mb-4 py-12 sm:px-6 sm:py-16">

    {/* Top row */}
    <div class="grid gap-10 sm:grid-cols-2 lg:grid-cols-4">

      {/* Brand + Contact */}
      <div class="flex flex-col gap-4 sm:col-span-2 lg:col-span-1">
        <a href={base} class="text-lg font-bold tracking-tight text-primary-50">
          {logo}
        </a>
        <p class="max-w-xs text-sm leading-relaxed text-primary-50">
          {description}
        </p>

        {/* Contact items */}
        <ul class="mt-2 flex flex-col gap-2.5">
          {email && (
            <li class="flex items-center gap-2.5 text-sm text-primary-50">
              <svg class="h-4 w-4 shrink-0 text-secondary-50" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75" />
              </svg>
              <a href={`mailto:${email}`} class="transition-colors hover:text-secondary-200">{email}</a>
            </li>
          )}
          {phone && (
            <li class="flex items-center gap-2.5 text-sm text-primary-50">
              <svg class="h-4 w-4 shrink-0 text-secondary-50" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 002.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 01-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 00-1.091-.852H4.5A2.25 2.25 0 002.25 4.5v2.25z" />
              </svg>
              <a href={`tel:${phone}`} class="transition-colors hover:text-secondary-200">{phone}</a>
            </li>
          )}
          {location && (
            <li class="flex items-center gap-2.5 text-sm text-primary-50">
              <svg class="h-4 w-4 shrink-0 text-secondary-50" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z" />
                <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z" />
              </svg>
              <span>{location}</span>
            </li>
          )}
        </ul>
      </div>

      {/* Link sections */}
      {sections.map((section) => (
        <div class="flex flex-col gap-3">
          <h4 class="text-sm font-semibold text-primary-50">{section.title}</h4>
          <ul class="flex flex-col gap-2">
            {section.links.map((link) => (
              <li>
                <a
                  href={link.href}
                  class="text-sm text-primary-50 transition-colors hover:text-secondary-200"
                >
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}

      {/* Social */}
      <div class="flex flex-col gap-3">
        <h4 class="text-sm font-semibold text-primary-50">Síguenos</h4>
        <div class="flex items-center gap-3">
          {/* GitHub */}
          <a href="#" class="text-primary-50 transition-colors hover:text-secondary-200" aria-label="GitHub">
            <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24">
              <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" />
            </svg>
          </a>
          {/* Twitter / X */}
          <a href="#" class="text-primary-50 transition-colors hover:text-secondary-200" aria-label="Twitter">
            <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24">
              <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z" />
            </svg>
          </a>
          {/* LinkedIn */}
          <a href="#" class="text-primary-50 transition-colors hover:text-secondary-200" aria-label="LinkedIn">
            <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24">
              <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z" />
            </svg>
          </a>
          {/* Instagram */}
          <a href="#" class="text-primary-50 transition-colors hover:text-secondary-200" aria-label="Instagram">
            <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24">
              <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z" />
            </svg>
          </a>
        </div>
      </div>
    </div>

    {/* Bottom bar */}
    <div class="mt-12 flex flex-col items-center justify-between gap-4 sm:flex-row">
      <p class="text-xs text-primary-50">
        &copy; {year} {logo}. Todos los derechos reservados.
      </p>
      <div class="flex items-center gap-4 text-xs text-primary-50">
        <a href="#" class="transition-colors hover:text-secondary-200">Privacidad</a>
        <a href="#" class="transition-colors hover:text-secondary-200">Términos</a>
        <a href="#" class="transition-colors hover:text-secondary-200">Cookies</a>
      </div>
    </div>
  </div>
</footer>
